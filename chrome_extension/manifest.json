{
  "manifest_version": 3,
  "name": "Trade Alert - Trump Monitor",
  "version": "0.5.0",
  "description": "Monitors verified public Trump posts and transfers them silently to the local Trade Alert Windows app.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://truthsocial.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://truthsocial.com/*"
      ],
      "js": [
        "relay.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://truthsocial.com/*"
      ],
      "js": [
        "reader.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "action": {
    "default_title": "Trade Alert: manage Trump Monitor and backup tab",
    "default_popup": "popup.html"
  }
}
